{
  "name": "moltbot-mobile",
  "version": "1.0.0",
  "license": "FSL-1.1-ALv2",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "web:build": "expo export --platform web --output-dir dist",
    "test": "jest --testPathPatterns='src/__tests__' --passWithNoTests"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@react-native-async-storage/async-storage": "<rootDir>/src/__tests__/__mocks__/async-storage.js",
      "expo-notifications": "<rootDir>/src/__tests__/__mocks__/expo-notifications.js",
      "react-native": "<rootDir>/src/__tests__/__mocks__/react-native.js",
      "^(\\.{1,2}/.+)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|expo)"
    ],
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.12.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-media-library": "~58.0.12",
    "expo-notifications": "~58.1.6",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "three": "^0.184.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.34.5"
  }
}
