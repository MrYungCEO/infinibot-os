{
  "name": "infinibot-control-ui",
  "version": "1.0.0",
  "description": "InfiniBot Control UI - Desktop Application",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "InfiniBot",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed:mobile": "vite build --config vite.embed.config.ts && node ../scripts/wrap-embed-html.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:voice-cli": "vitest run --config vitest.config.ts src/ui/views/voice-robovoice/cli-route-state.test.ts src/ui/views/voice-robovoice/voice-console.test.ts",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 npx electron .\"",
    "electron:build": "npm run build && npx electron-builder",
    "electron:build:win": "npm run build && npx electron-builder --win",
    "electron:build:mac": "npm run build && npx electron-builder --mac",
    "electron:build:linux": "npm run build && npx electron-builder --linux",
    "electron:preview": "npm run build && npx electron .",
    "electron:start": "npx electron ."
  },
  "dependencies": {
    "@appletosolutions/reactbits": "^1.0.3",
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@excalidraw/excalidraw": "^0.18.0",
    "@lit/context": "^1.1.6",
    "@motionone/types": "^10.17.1",
    "@noble/ed25519": "^3.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@types/d3": "^7.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "d3": "^7.9.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.38.0",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lightweight-charts": "4.1.0",
    "lit": "^3.3.2",
    "livekit-client": "^2.17.0",
    "marked": "^17.0.1",
    "matter-js": "^0.20.0",
    "meshline": "^3.3.1",
    "ogl": "^1.0.11",
    "onnxruntime-web": "^1.24.3",
    "pixi-viewport": "^4.38.0",
    "pixi.js": "^6.5.10",
    "postprocessing": "^6.39.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.0.18",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.infinibot.desktop",
    "productName": "InfiniBot",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/control-ui/**/*",
      "electron/**/*",
      "public/**/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme}",
      "!**/node_modules/.bin",
      "!**/*.{ts,tsx,map}",
      "!**/vitest*",
      "!**/playwright*",
      "!**/@vitest/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InfiniBot"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/infinibot-logo.png",
      "category": "Development"
    }
  }
}
