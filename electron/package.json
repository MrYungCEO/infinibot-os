{
  "name": "infinibot-desktop",
  "version": "2026.11.1",
  "description": "InfiniBot",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/MrYungCEO/infinibot-os",
  "author": {
    "name": "InfiniBot",
    "email": "MrYungCEO@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "node scripts/rebuild-native.mjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.infinibot.desktop",
    "productName": "InfiniBot",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.js",
      "license.js",
      "desktop-update.js",
      "external-links.js",
      "kv-browser-flow.js",
      "kv-deep-link.js",
      "provider-models.js",
      "satellite.js",
      "config-io.js",
      "satellite-status.html",
      "satellite-status.js",
      "index.html",
      "renderer.js",
      "wizard.html",
      "wizard.js",
      "components/**/*",
      "!components/*.test.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app/dist",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.map",
          "!**/*.test.js",
          "!**/__tests__/**",
          "!**/__fixtures__/**",
          "!control-ui.prev-*/**",
          "!control-ui.before-*/**"
        ]
      },
      {
        "from": "../package.json",
        "to": "app/package.json"
      },
      {
        "from": "../docs/reference/templates",
        "to": "app/docs/reference/templates"
      },
      {
        "from": "../extensions",
        "to": "app/extensions",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.map",
          "!**/*.test.*",
          "!**/{test,tests}/**",
          "!**/__tests__/**",
          "!**/__fixtures__/**"
        ]
      },
      {
        "from": "../mobile/dist",
        "to": "app/mobile-web",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.map"
        ]
      },
      {
        "from": "../mobile",
        "to": "app/mobile",
        "filter": [
          "**/*",
          "!**/.env*",
          "!node_modules/**",
          "!dist/**",
          "!.expo/**",
          "!web-build/**",
          "!**/*.map"
        ]
      },
      {
        "from": "../node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/*.{md,markdown,ts,tsx,map,d.ts.map}",
          "!**/{test,tests,__tests__,example,examples,benchmark,benchmarks,docs,demo}/**",
          "!**/.bin/**",
          "!**/.cache/**",
          "!**/CHANGELOG*",
          "!**/HISTORY*",
          "!**/AUTHORS*",
          "!**/LICENSE*",
          "!**/license*",
          "!**/*.flow",
          "!**/@rolldown/**",
          "!**/@oxlint/**",
          "!**/@oxlint-tsgolint/**",
          "!**/@oxfmt/**",
          "!**/@typescript/**",
          "!**/@esbuild/**",
          "!**/@babel/**",
          "!**/typescript/**",
          "!**/vitest/**",
          "!**/@vitest/**",
          "!**/@node-llama-cpp/**",
          "!**/node-llama-cpp/bins/**",
          "!**/*-darwin-*/**",
          "!**/*-linux-*/**",
          "!**/*-android-*/**",
          "!**/sharp-libvips-linux*/**",
          "!**/sharp-libvips-linuxmusl-*/**",
          "!**/sharp-libvips-darwin-*/**",
          "!**/sharp-linux-*/**",
          "!**/sharp-darwin-*/**",
          "!**/sharp-linuxmusl-*/**",
          "!**/canvas-linux-*/**",
          "!**/canvas-darwin-*/**",
          "!**/canvas-android-*/**",
          "!**/node-pty-linux-*/**",
          "!**/node-pty-darwin-*/**",
          "!**/reflink-linux-*/**",
          "!**/reflink-darwin-*/**",
          "!**/clipboard-linux-*/**",
          "!**/clipboard-darwin-*/**",
          "!**/sqlite-vec-linux-*/**",
          "!**/sqlite-vec-darwin-*/**",
          "!**/rollup-linux-*/**",
          "!**/rollup-darwin-*/**",
          "!**/rollup-android-*/**",
          "!**/.pnpm/@napi-rs+canvas-linux-*/**",
          "!**/.pnpm/@napi-rs+canvas-darwin-*/**",
          "!**/.pnpm/@napi-rs+canvas-android-*/**",
          "!**/.pnpm/@img+sharp-linux-*/**",
          "!**/.pnpm/@img+sharp-linuxmusl-*/**",
          "!**/.pnpm/@img+sharp-darwin-*/**",
          "!**/.pnpm/@img+sharp-libvips-linux*/**",
          "!**/.pnpm/@img+sharp-libvips-darwin-*/**",
          "!**/.pnpm/@mariozechner+clipboard-linux-*/**",
          "!**/.pnpm/@mariozechner+clipboard-darwin-*/**",
          "!**/.pnpm/@lydell+node-pty-linux-*/**",
          "!**/.pnpm/@lydell+node-pty-darwin-*/**",
          "!**/.pnpm/@reflink+reflink-linux-*/**",
          "!**/.pnpm/@reflink+reflink-darwin-*/**",
          "!**/.pnpm/@rollup+rollup-linux-*/**",
          "!**/.pnpm/@rollup+rollup-darwin-*/**",
          "!**/.pnpm/@rollup+rollup-android-*/**",
          "!**/.pnpm/sqlite-vec-linux-*/**",
          "!**/.pnpm/sqlite-vec-darwin-*/**",
          "!**/@fontsource/**",
          "!**/.pnpm/@fontsource+*/**",
          "!**/playwright/**/.local-browsers/**",
          "!**/playwright-core/**/.local-browsers/**",
          "!**/puppeteer/.local-chromium/**",
          "!**/puppeteer-core/.local-chromium/**",
          "!**/app-builder-bin/**",
          "!**/7zip-bin/**",
          "!**/oxfmt/**",
          "!**/oxlint/**",
          "!**/oxlint-tsgolint/**",
          "!**/quicktype-core/**",
          "!**/rolldown/**",
          "!**/wireit/**",
          "!**/lucide/**",
          "!**/react-icons/**",
          "!**/react-dom/**",
          "!**/@excalidraw/**",
          "!**/@mediapipe/**",
          "!**/mermaid/**",
          "!**/three/**",
          "!**/three-stdlib/**",
          "!**/@dimforge/**",
          "!**/cytoscape/**",
          "!**/cytoscape-*/**",
          "!**/hls.js/**",
          "!**/onnxruntime-web/**",
          "!**/@lancedb/**",
          "!**/onnxruntime-node/bin/napi-v3/darwin/**",
          "!**/onnxruntime-node/bin/napi-v3/linux/**",
          "!**/better-sqlite3/build/Release/obj/**",
          "!**/better-sqlite3/build/deps/**",
          "!**/*.pdb",
          "!**/*.iobj",
          "!**/*.ipdb",
          "!**/*.obj",
          "!**/*.lib",
          "!**/*.exp"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@lydell/node-pty/**",
      "**/node_modules/sharp/**",
      "launcher.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "publisherName": "InfiniBot",
      "legalTrademarks": "InfiniBot"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrYungCEO",
        "repo": "InfiniBot",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "InfiniBot <MrYungCEO@users.noreply.github.com>",
      "vendor": "InfiniBot",
      "synopsis": "InfiniBot Desktop — local gateway + web UI",
      "description": "InfiniBot Desktop bundles the InfiniBot gateway and serves its web UI in a native window. Mobile devices connect to the same gateway over your LAN. Voice runs on Robovoice — link it from the Voice page or with `infinibot robovoice login`.",
      "desktop": {
        "Name": "InfiniBot",
        "Comment": "Local AI agent gateway + web UI",
        "Categories": "Development;Utility;Network;",
        "StartupWMClass": "InfiniBot"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InfiniBot",
      "uninstallDisplayName": "InfiniBot ${version}",
      "artifactName": "InfiniBot-Setup-${version}.${ext}",
      "differentialPackage": false,
      "include": "build/installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "menuCategory": false
    },
    "portable": {
      "artifactName": "InfiniBot-Portable-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "InfiniBot-${version}.${ext}"
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "devel",
      "artifactName": "infinibot_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "afterInstall": "build/deb/postinst.sh",
      "afterRemove": "build/deb/postrm.sh"
    },
    "copyright": "Copyright © 2026 InfiniBot"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  }
}
