{
  "manifestVersion": 2,
  "id": "discipline",
  "name": "Discipline",
  "version": "2026.9.28",
  "minHostVersion": "2026.6.30",
  "publisher": "infinibot",
  "license": "FSL-1.1-ALv2",
  "description": "ADHD-friendly day planner: time blocks with routines, completions and day/week scores, saved schedule templates, business-aware block insights, block alerts and a Telegram bridge — plus the Focus board (your top five tasks/projects).",
  "engines": {
    "infinibot-plugin-api": "^2.0.0"
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoLog": {
        "type": "boolean",
        "description": "Log agent activity and task completions against the active block, auto-start the day on first activity and auto-complete a block when work lands inside it. Default on."
      },
      "alerts": {
        "type": "boolean",
        "description": "Block start / missed alerts, the 09:30 check-in and the 21:00 evening wrap (in-app + push). Default on."
      },
      "telegramBridge": {
        "type": "boolean",
        "description": "Send block start/end messages to the Telegram chat set in Discipline settings. Default on (still needs Telegram switched on in the page's settings)."
      }
    }
  },
  "uiHints": {
    "autoLog": {
      "label": "Auto-log agent activity"
    },
    "alerts": {
      "label": "Block alerts & daily check-ins"
    },
    "telegramBridge": {
      "label": "Telegram block messages"
    }
  },
  "contributes": {
    "learn": "learn.json",
    "nav": [
      {
        "tab": "discipline",
        "label": "Discipline",
        "icon": "target",
        "group": "Work"
      }
    ],
    "pages": [
      {
        "tab": "discipline",
        "route": "/discipline",
        "builtin": "discipline",
        "title": "Day planner"
      },
      {
        "tab": "focus",
        "route": "/focus",
        "builtin": "focus",
        "title": "Focus board"
      }
    ],
    "navSection": {
      "title": "Discipline",
      "items": [
        {
          "page": "discipline",
          "label": "Day",
          "icon": "target"
        },
        {
          "page": "focus",
          "label": "Focus board",
          "icon": "star"
        }
      ]
    },
    "mapRoom": {
      "title": "Discipline Dojo",
      "theme": "dojo",
      "size": "S",
      "placement": "north"
    },
    "subviews": [
      {
        "id": "focus",
        "label": "Focus board",
        "host": "discipline"
      }
    ],
    "overlays": [
      {
        "id": "discipline-alerts",
        "label": "Block alert toasts",
        "trigger": "topbar"
      }
    ],
    "rpc": [
      {
        "method": "discipline.state",
        "scope": "read"
      },
      {
        "method": "discipline.blocks.list",
        "scope": "read"
      },
      {
        "method": "discipline.blocks.create",
        "scope": "write"
      },
      {
        "method": "discipline.blocks.update",
        "scope": "write"
      },
      {
        "method": "discipline.blocks.delete",
        "scope": "write"
      },
      {
        "method": "discipline.blocks.complete",
        "scope": "write"
      },
      {
        "method": "discipline.blocks.uncomplete",
        "scope": "write"
      },
      {
        "method": "discipline.blocks.overrides.reset",
        "scope": "write"
      },
      {
        "method": "discipline.logs.list",
        "scope": "read"
      },
      {
        "method": "discipline.logs.create",
        "scope": "write"
      },
      {
        "method": "discipline.logs.update",
        "scope": "write"
      },
      {
        "method": "discipline.logs.delete",
        "scope": "write"
      },
      {
        "method": "discipline.settings.get",
        "scope": "read"
      },
      {
        "method": "discipline.settings.update",
        "scope": "write"
      },
      {
        "method": "discipline.routine.status",
        "scope": "read"
      },
      {
        "method": "discipline.routine.toggle",
        "scope": "write"
      },
      {
        "method": "discipline.score.day",
        "scope": "read"
      },
      {
        "method": "discipline.score.range",
        "scope": "read"
      },
      {
        "method": "discipline.score.week",
        "scope": "read"
      },
      {
        "method": "discipline.templates.list",
        "scope": "read"
      },
      {
        "method": "discipline.templates.get",
        "scope": "read"
      },
      {
        "method": "discipline.templates.create",
        "scope": "write"
      },
      {
        "method": "discipline.templates.update",
        "scope": "write"
      },
      {
        "method": "discipline.templates.delete",
        "scope": "write"
      },
      {
        "method": "discipline.templates.apply",
        "scope": "write"
      },
      {
        "method": "discipline.events.list",
        "scope": "read"
      },
      {
        "method": "discipline.insights",
        "scope": "read"
      },
      {
        "method": "discipline.day.status",
        "scope": "read"
      },
      {
        "method": "discipline.start_day",
        "scope": "write"
      },
      {
        "method": "discipline.end_day",
        "scope": "write"
      },
      {
        "method": "discipline.shift_from_now",
        "scope": "write"
      },
      {
        "method": "discipline.notion.status",
        "scope": "read"
      },
      {
        "method": "discipline.notion.connect",
        "scope": "write",
        "requires": [
          "network:api.notion.com"
        ]
      },
      {
        "method": "discipline.notion.disconnect",
        "scope": "write"
      },
      {
        "method": "discipline.notion.syncNow",
        "scope": "write",
        "requires": [
          "network:api.notion.com"
        ]
      },
      {
        "method": "discipline.focus.list",
        "scope": "read"
      },
      {
        "method": "discipline.focus.status",
        "scope": "read"
      },
      {
        "method": "discipline.focus.get",
        "scope": "read"
      },
      {
        "method": "discipline.focus.contains",
        "scope": "read"
      },
      {
        "method": "discipline.focus.add.task",
        "scope": "write",
        "requires": [
          "network:api.notion.com"
        ]
      },
      {
        "method": "discipline.focus.add.project",
        "scope": "write",
        "requires": [
          "network:api.notion.com"
        ]
      },
      {
        "method": "discipline.focus.remove",
        "scope": "write"
      },
      {
        "method": "discipline.focus.reorder",
        "scope": "write"
      },
      {
        "method": "discipline.focus.moveUp",
        "scope": "write"
      },
      {
        "method": "discipline.focus.moveDown",
        "scope": "write"
      },
      {
        "method": "discipline.focus.clear",
        "scope": "write"
      },
      {
        "method": "discipline.focus.sync",
        "scope": "write",
