          "network:api.notion.com"
        ]
      },
      {
        "method": "discipline.focus.set",
        "scope": "write"
      }
    ],
    "http": [],
    "tools": [
      {
        "name": "discipline"
      },
      {
        "name": "focus"
      }
    ],
    "services": [
      "discipline-runtime"
    ]
  },
  "permissions": {
    "network": [
      "api.notion.com (Notion sync + Focus lookups, only when connected)"
    ],
    "fs": [
      "<stateDir>/plugin-data/discipline",
      "<stateDir>/discipline.db, discipline-notion.json, focus.json (one-time move in)"
    ],
    "exec": false,
    "secrets": [
      "NOTION_API_KEY"
    ],
    "channels": [
      "telegram"
    ],
    "credits": false
  },
  "appearance": {
    "accent": "token:primary",
    "tint": "none",
    "tintStrength": 0.06,
    "density": "comfortable",
    "fontScale": 1,
    "icon": "target",
    "monogram": "DS"
  },
  "listing": {
    "tagline": "Plan your day in time blocks, keep your streak, and let your agents' work check the boxes for you.",
    "description": "**Discipline** is a day planner built for people who drift.\n\n- **Time blocks** — lay out the day with routines, intents and hard / non-negotiable blocks; the page follows the clock and shows what's up now and next.\n- **It notices your work** — agent runs and finished kanban tasks are logged against the active block, the day starts itself on your first activity, and a block completes when real work lands inside it.\n- **Scores and streaks** — day and week scores, completion streaks and an end-of-day view.\n- **Insights per block** — each block gets a short, business-aware suggestion from your open tasks, deadlines and clients.\n- **Templates** — save a schedule (\"Workday\", \"Weekend\") and apply it in one step.\n- **Focus board** — pin up to five tasks or projects you're committing to.\n- **Alerts** — block start / missed alerts, a morning check-in and an evening wrap, in-app and on Telegram if you want.\n\nAgents can drive all of it through the `discipline` and `focus` tools.",
    "category": "apps",
    "tags": [
      "planner",
      "time-blocking",
      "focus",
      "adhd",
      "routines",
      "productivity"
    ],
    "cover": "assets/cover.svg",
    "icon": "assets/icon.svg",
    "screenshots": [
      {
        "src": "assets/shot-1.webp",
        "caption": "Day — time blocks with the live now-line and today's score"
      },
      {
        "src": "assets/shot-2.webp",
        "caption": "Focus board — your top five, pulled from projects and tasks"
      }
    ],
    "publisher": {
      "name": "InfiniBot"
    }
  }
}
