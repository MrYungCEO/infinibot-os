  "permissions": {
    "network": [
      "<configured Robovoice URL>",
      "https://robovoice.io"
    ],
    "fs": [
      "<stateDir>/plugin-data/robovoice",
      "<sharedDir>/plugin-data/robovoice"
    ],
    "exec": false,
    "secrets": [
      "robovoice.deviceKey",
      "robovoice.edgeToken",
