{
  "manifestVersion": 2,
  "id": "content-studio",
  "name": "Content Studio",
  "version": "2026.10.6",
  "minHostVersion": "2026.6.30",
  "publisher": "infinibot",
  "license": "FSL-1.1-ALv2",
  "description": "Social content workspace: a drag-and-drop production pipeline (customizable stages, WIP limits) where every content item opens a rich markdown page with images, video and audio; free-form Ideas pages you can promote onto the board; content pages per channel with child databases, insights and Instagram/ManyChat connections; a video posting queue per page that posts through your own logged-in Instagram/TikTok accounts on Droid Swarm phones (schedule windows, daily caps, caption templates, approval mode, dry run); Content Intelligence (reel library, viral-format scoring, transcripts, trends); script generation with viral examples; the CMO and content agents.",
  "engines": {
    "infinibot-plugin-api": "^2.0.0"
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "instagramSync": {
        "type": "boolean",
        "description": "Refresh Instagram stats for connected content pages in the background (only runs once a page has Instagram connected). Default on."
      },
      "pipelineDir": {
        "type": "string",
        "description": "Directory of your own reel collection/scoring pipeline (its output/ folder holds downloaded reels). Empty = pipeline features off."
      },
      "venvPath": {
        "type": "string",
        "description": "Python virtualenv for that pipeline. Empty = system python3."
      }
    }
  },
  "uiHints": {
    "instagramSync": {
      "label": "Background Instagram sync"
    },
    "pipelineDir": {
      "label": "Reel pipeline directory",
      "advanced": true
    },
    "venvPath": {
      "label": "Reel pipeline virtualenv",
      "advanced": true
    }
  },
  "contributes": {
    "learn": "learn.json",
