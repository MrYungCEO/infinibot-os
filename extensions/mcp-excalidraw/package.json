{
  "name": "@infinibot/whiteboard",
  "version": "2026.11.1",
  "type": "module",
  "private": true,
  "description": "MCP server giving InfiniBot agents full control of the Excalidraw canvas (rectangles, ellipses, arrows, text, freedraw, frames, images, group/arrange/view).",
  "license": "FSL-1.1-ALv2",
  "infinibot": {
    "extensions": [
      "./index.ts"
    ]
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-excalidraw": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "register": "node scripts/register.mjs",
    "postbuild": "node -e \"try{require('node:fs').chmodSync('dist/index.js',0o755)}catch{}\""
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@modelcontextprotocol/sdk": "*",
    "ws": "*",
    "zod": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "@types/node": "*",
    "@types/ws": "*"
  }
}
