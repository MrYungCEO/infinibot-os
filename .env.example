# InfiniBot Environment Configuration
# Copy this file to .env and fill in your actual API keys
# Required keys are marked with (REQUIRED)
# Recommended keys have (RECOMMENDED)
# Optional keys have (OPTIONAL)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INFRASTRUCTURE (REQUIRED OR HIGHLY RECOMMENDED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# InfiniBot state directory - where configs and data are stored
INFINIBOT_STATE_DIR=~/.infinibot

# Gateway authentication token - REQUIRED for remote/mobile access
# Generate a strong random token: node -e "console.log(require('crypto').randomUUID())"
# Also used by the Python voice agent (docker-compose.voice.yaml) as its
# `Authorization: Bearer` for gateway HTTP calls; if unset there it falls back
# to INFINIBOT_GATEWAY_PASSWORD. The gateway accepts either secret as Bearer.
INFINIBOT_GATEWAY_TOKEN=your-secure-gateway-token-here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MODEL PROVIDERS (AT LEAST ONE REQUIRED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Anthropic Claude - RECOMMENDED (best long-context + safety)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api-xxxxx

# OR use OAuth instead of API key:
# ANTHROPIC_OAUTH_TOKEN=...

# OpenAI - GPT-4, Codex
# Get from: https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxx

# Groq - Very fast inference with open weights
# Get from: https://console.groq.com/
GROQ_API_KEY=gsk_xxxxxxxx

# Google AI (Gemini)
# Get from: https://makersuite.google.com/
GEMINI_API_KEY=AIxxxxx

# OpenRouter - Access to many models
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-xxxxxxxx

# vLLM / Local Models - For self-hosted inference
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=optional-api-key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# IMAGE & VIDEO GENERATION (RECOMMENDED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Replicate - FLUX, SDXL, video models
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxx

# Atlas Cloud - Uncensored video (Wan 2.6)
# Get from: https://atlascloud.ai/
ATLAS_CLOUD_API_KEY=apikey-xxxxxxxx

# HeyGen - Avatar videos
# Get from: https://app.heygen.com/settings/api
HEYGEN_API_KEY=sk_V2_xxxxxxxx

# Veo 3 (Google) - For video generation
# Uses GEMINI_API_KEY above

# Nano Banana Pro - Image generation
# Uses GEMINI_API_KEY above

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SPEECH & AUDIO (OPTIONAL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Deepgram - Speech-to-text
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=xxxxxxxx

# ElevenLabs - High quality text-to-speech
# Get from: https://elevenlabs.io/app/settings/api
ELEVENLABS_API_KEY=sk_xxxxxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SEARCH & WEB (OPTIONAL BUT HIGHLY USEFUL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Brave Search API
# Get from: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=BSxxxxxxxx

# Perplexity API - For research queries
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOTION INTEGRATION (RECOMMENDED FOR PROJECTS/KANBAN)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Notion API key for kanban/projects sync
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CHANNEL INTEGRATIONS (OPTIONAL - ENABLE WHAT YOU NEED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Telegram Bot
# Create bot via @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=xxxxxxxxx:xxxxxxxxxxxxxxxx

# Discord Bot
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Slack Bot
# Create at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxx-xxxxxxxxx-xxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxx

# WhatsApp (via Twilio) - Business API only
# Your Twilio credentials:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+12345678901

# Signal
# Requires signal-cli setup
# SIGNAL_PHONE_NUMBER=+12345678901

# iMessage (macOS only)
# No API key required, uses local iMessage

# Google Chat
# Create at: https://console.cloud.google.com/apis/library/chat.googleapis.com
# GOOGLE_CHAT_SERVICE_ACCOUNT_KEY='{...json...}'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADVANCED / OPTIONAL INTEGRATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GitHub Copilot (for models via Copilot proxy)
# GITHUB_COPILOT_TOKEN=xxxxxxxx

# Minimax - Video/image generation
# MINIMAX_API_KEY=xxxxxxxx

# Moonshot AI
# MOONSHOT_API_KEY=xxxxxxxx

# Venice AI - Private, uncensored inference
# VENICE_API_KEY=xxxxxxxx

# ZAI
# ZAI_API_KEY=xxxxxxxx

# RunPod - GPU cloud
# RUNPOD_API_KEY=rpa_xxxxxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CANVA CONNECT API (OPTIONAL — enables Canva MCP)
# Manage your Canva apps at: https://www.canva.com/developers/
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# OAuth 2.0 PKCE flow (recommended — enables "Sign in with Canva" button in the UI).
# Create an integration at https://www.canva.com/developers/ → Your integrations → Create.
# Set the redirect URI to: http://127.0.0.1:<gateway-port>/oauth/canva/callback
# (default gateway port is 18789, so: http://127.0.0.1:18789/oauth/canva/callback)
CANVA_OAUTH_CLIENT_ID=AABBccddEEff...
# Only needed for confidential clients (leave blank for PKCE-only public clients):
# CANVA_OAUTH_CLIENT_SECRET=your_client_secret_here
# Override the redirect URI if your gateway runs on a different host/port:
# CANVA_OAUTH_REDIRECT_URI=http://127.0.0.1:18789/oauth/canva/callback
# Override default scopes (space-separated list):
# CANVA_OAUTH_SCOPES=design:content:read design:content:write design:meta:read asset:read asset:write brandtemplate:content:read brandtemplate:meta:read profile:read

# Alternative: personal access token (static, no expiry, no OAuth popup needed).
# Get from: https://www.canva.com/developers/apps → your integration → Generate token
# CANVA_ACCESS_TOKEN=your_canva_access_token_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BUSINESS / MONETIZATION (OPTIONAL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Whop - For KinglyVault/community memberships
# WHOP_API_KEY=whop_xxxxxxxx

# Stripe - For payment processing
# STRIPE_API_KEY=sk_live_xxxxxxxx

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CLOUD PROVIDERS (OPTIONAL - FOR DEPLOYMENT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Fly.io
# FLY_API_TOKEN=xxxxxxxx

# Vercel
# VERCEL_TOKEN=xxxxxxxx

# Supabase (for KinglyVault database)
# SUPABASE_URL=https://xxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SUPABASE MCP (OPTIONAL — enables Supabase MCP for agents)
# The hosted Supabase MCP at https://mcp.supabase.com/mcp
# exposes: list_tables, execute_sql, apply_migration, get_logs,
#          list_projects, generate_typescript_types, and more.
# Set via the UI: MCPs page → Supabase → CONNECT
# or set SUPABASE_PAT here to auto-register on gateway start.
# Get a token at: https://supabase.com/dashboard/account/tokens
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Personal access token (set via MCPs page or directly here):
# SUPABASE_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: scope MCP to a single project (found in project URL):
# SUPABASE_PROJECT_REF=abcdefghijklmnop

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEBUG & DEVELOPMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable verbose logging
# DEBUG=1
# INFINIBOT_LOG_LEVEL=debug

# Load shell environment into InfiniBot
# INFINIBOT_LOAD_SHELL_ENV=1

# Skip update checks
# INFINIBOT_SKIP_UPDATE_CHECK=1
