/**
 * Regenerate the Business hub RPC surface that must stay static:
 *   - src/business-hub/rpc/method-scopes.ts (read by src/business-agency/methods.ts
 *     without importing any handler module), and
 *   - extensions/business-agency/infinibot.plugin.json contributes.rpc + rpcAliases
 *     for every `hub.*` method (plugin name `business-agency.hub.*`, legacy alias `hub.*`).
 *
 * Run: node --import tsx scripts/business-hub/gen-method-scopes.mts
 * business-hub methods.test.ts fails when these drift from the handlers.
 */

import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { BUSINESS_HUB_METHOD_SCOPES, businessHubHandlers } from "../../src/business-hub/rpc/index.js";

const root = join(import.meta.dirname, "..", "..");
const methods = Object.keys(businessHubHandlers).sort();
for (const m of methods) if (!BUSINESS_HUB_METHOD_SCOPES[m]) throw new Error(`no scope for ${m}`);

const body = methods.map((m) => `  "${m}": "${BUSINESS_HUB_METHOD_SCOPES[m]}",`).join("\n");
writeFileSync(
  join(root, "src/business-hub/rpc/method-scopes.ts"),
  `/**
 * Business hub RPC methods and their scopes — GENERATED by
 * scripts/business-hub/gen-method-scopes.mts from the handlers in rpc/*.ts.
 * Static on purpose: src/business-agency/methods.ts reads it eagerly and must
 * not load any handler module. Do not edit by hand.
 */

export const HUB_METHOD_SCOPES = {
${body}
} as const satisfies Record<string, "read" | "write" | "admin">;
`,
);

const manifestPath = join(root, "extensions/business-agency/infinibot.plugin.json");
const manifest = JSON.parse(readFileSync(manifestPath, "utf8")) as {
  contributes: { rpc: Array<{ method: string; scope: string }>; rpcAliases: Array<{ method: string; target: string }> };
};
const c = manifest.contributes;
c.rpc = c.rpc.filter((r) => !r.method.startsWith("business-agency.hub."));
c.rpcAliases = c.rpcAliases.filter((a) => !a.method.startsWith("hub."));
for (const m of methods) {
  c.rpc.push({ method: `business-agency.${m}`, scope: BUSINESS_HUB_METHOD_SCOPES[m] });
  c.rpcAliases.push({ method: m, target: `business-agency.${m}` });
}
writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`);
console.log(`wrote ${methods.length} hub methods`);
