{
  "name": "infinibot",
  "version": "2026.11.1",
  "description": "Personal AI assistant — multi-channel gateway with agent orchestration",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin-sdk": "./dist/plugin-sdk/index.js",
    "./plugin-sdk/*": "./dist/plugin-sdk/*",
    "./cli-entry": "./dist/entry.js"
  },
  "bin": {
    "infinibot": "dist/entry.js"
  },
  "files": [
    "dist/**",
    "!dist/test-helpers/**",
    "!dist/test-utils/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map",
    "!dist/InfiniBot.app/**",
    "docs/**",
    "!docs/reference/templates/MEMORY.md",
    "!docs/reference/templates/TOOLS.md",
    "!docs/reference/templates/IDENTITY.md",
    "!docs/reference/templates/SOUL.md",
    "!docs/reference/templates/USER.md",
    "!docs/*.html",
    "!docs/*-perf-*.json",
    "!docs/docs/**",
    "!docs/assets/landing/**",
    "!docs/frames/**",
    "!docs/videos/**",
    "!docs/voice-holo-control-center/**",
    "!docs/proactive/**",
    "!docs/proactive-presenter/**",
    "!docs/infinibar/**",
    "!docs/netlify/**",
    "!docs/netlify.toml",
    "!docs/_redirects",
    "!docs/_headers",
    "!docs/_layouts/**",
    "!docs/_config.yml",
    "!docs/CNAME",
    "!docs/sitemap.xml",
    "!docs/robots.txt",
    "!docs/npm-publish-checklist.md",
    "!docs/release-automation-verification.md",
    "!docs/release-publisher.md",
    "!docs/android-ops-cheapest-email-setup.md",
    "!docs/licensing/PRIVATE-SPLIT.md",
    "!docs/saas/**",
    "!docs/verification/**",
    "!docs/licensing/commercial-licensing-verification.md",
    "!docs/licensing/commercial-licensing-setup.md",
    "!docs/licensing/LEGAL-REVIEW-NOTES.md",
    "!docs/**/VERIFICATION.md",
    "extensions/**",
    "!extensions/**/node_modules/**",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.test.tsx",
    "!extensions/*/test/**",
    "!extensions/*/tests/**",
    "!extensions/*/verification/**",
    "assets/**",
    "skills/**",
    "!skills/_drafts/**",
    "mobile/**",
    "!mobile/node_modules/**",
    "!mobile/dist/**",
    "!mobile/.expo/**",
    "!mobile/android/**",
    "!mobile/ios/**",
    "!mobile/.external-roots.json",
    "!mobile/src/__tests__/**",
    "patches/**",
    "README.md",
    "README-header.png",
    "CHANGELOG.md",
    "LICENSE",
    "COMMERCIAL.md",
    "scripts/postinstall.js",
    "scripts/format-staged.js",
    "scripts/setup-git-hooks.js",
    "scripts/fix-hyperframes-esm.mjs",
    "scripts/visual-verify.mjs",
    "scripts/visual-qa-multidevice.mjs",
    "scripts/desktop-control.ps1",
    "scripts/desktop-ui.ps1",
    "scripts/install-infinibot.sh",
    "scripts/install-infinibot.ps1",
    "git-hooks/**",
    "!extensions/**/*.test.mjs"
  ],
  "scripts": {
    "dev": "node scripts/run-node.mjs",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "pnpm build && pnpm ui:build",
    "docs:list": "node scripts/docs-list.js",
    "docs:bin": "node scripts/build-docs-list.mjs",
    "docs:dev": "cd docs && mint dev",
    "docs:build": "node scripts/render-docs-static.mjs",
    "docs:lint": "cd docs && pnpm dlx --reporter append-only mint broken-links",
    "build": "node scripts/clean-artifacts.mjs && pnpm canvas:a2ui:bundle && node --import tsx scripts/gen-infinibot-knowledge.ts && tsc -p tsconfig.json && node --import tsx scripts/canvas-a2ui-copy.ts && node --import tsx scripts/copy-hook-metadata.ts && node --import tsx scripts/copy-design-seeds.ts && node --import tsx scripts/copy-content-intel-pipeline.ts && node --import tsx scripts/write-build-info.ts && node scripts/verify-build.mjs",
    "ui-targets:gen": "node --import tsx scripts/ui-targets/gen-ui-targets.ts",
    "ui-targets:check": "node --import tsx scripts/ui-targets/gen-ui-targets.ts --check",
    "build:all": "pnpm build && pnpm ui:build",
    "clean": "node scripts/clean-artifacts.mjs",
    "clean:deep": "node scripts/clean-artifacts.mjs --deep",
    "verify:build": "node scripts/verify-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plugins:sync": "node --import tsx scripts/sync-plugin-versions.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "ui:install": "node scripts/ui.js install",
    "ui:dev": "node scripts/ui.js dev",
    "ui:build": "node scripts/ui.js build",
    "ext:build": "node scripts/build-chrome-extension.mjs",
    "voice:stt-accuracy": "node --import tsx scripts/voice/stt-accuracy.mts",
    "start": "node scripts/run-node.mjs",
    "infinibot": "node scripts/run-node.mjs",
    "gateway:watch": "node scripts/watch-node.mjs gateway --force",
    "gateway:dev": "INFINIBOT_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway",
    "gateway:dev:reset": "INFINIBOT_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway --reset",
    "tui": "node scripts/run-node.mjs tui",
    "tui:dev": "INFINIBOT_PROFILE=dev node scripts/run-node.mjs tui",
    "infinibot:rpc": "node scripts/run-node.mjs agent --mode rpc --json",
    "ios:gen": "cd apps/ios && xcodegen generate",
    "ios:open": "cd apps/ios && xcodegen generate && open Moltbot.xcodeproj",
    "ios:build": "bash -lc 'cd apps/ios && xcodegen generate && xcodebuild -project Moltbot.xcodeproj -scheme Moltbot -destination \"${IOS_DEST:-platform=iOS Simulator,name=iPhone 17}\" -configuration Debug build'",
    "ios:run": "bash -lc 'cd apps/ios && xcodegen generate && xcodebuild -project Moltbot.xcodeproj -scheme Moltbot -destination \"${IOS_DEST:-platform=iOS Simulator,name=iPhone 17}\" -configuration Debug build && xcrun simctl boot \"${IOS_SIM:-iPhone 17}\" || true && xcrun simctl launch booted com.clawdbot.ios'",
    "android:assemble": "cd apps/android && ./gradlew :app:assembleDebug",
    "android:install": "cd apps/android && ./gradlew :app:installDebug",
    "android:run": "cd apps/android && ./gradlew :app:installDebug && adb shell am start -n com.clawdbot.android/.MainActivity",
    "android:test": "cd apps/android && ./gradlew :app:testDebugUnitTest",
    "mac:restart": "bash scripts/restart-mac.sh",
    "mac:package": "bash scripts/package-mac-app.sh",
    "mac:open": "open dist/Moltbot.app",
    "electron:install": "cd electron && npm install",
    "electron:dev": "cd electron && npm start",
    "electron:rebuild": "cd electron && npm run rebuild",
    "mobile:web:build": "cd mobile && npx expo export --platform web --output-dir dist",
    "electron:bundle:prepare": "pnpm build && pnpm ui:build && pnpm mobile:web:build && cd electron && npm install && npm run rebuild",
    "electron:build": "pnpm electron:bundle:prepare && cd electron && npm run build",
    "electron:build:win": "pnpm electron:bundle:prepare && cd electron && npm run build:win",
    "electron:build:mac": "pnpm electron:bundle:prepare && cd electron && npm run build:mac",
    "electron:build:linux": "pnpm electron:bundle:prepare && cd electron && npm run build:linux",
    "electron:dist": "pnpm electron:bundle:prepare && cd electron && npm run build",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "lint:full": "oxlint --type-aware src test",
    "lint:swift": "swiftlint lint --config .swiftlint.yml && (cd apps/ios && swiftlint lint --config .swiftlint.yml)",
    "lint:all": "pnpm lint && pnpm lint:swift",
    "lint:fix": "pnpm format:fix && oxlint --type-aware --fix src test",
    "format": "oxfmt --check src test",
    "format:swift": "swiftformat --lint --config .swiftformat apps/macos/Sources apps/ios/Sources apps/shared/ClawdbotKit/Sources",
    "format:all": "pnpm format && pnpm format:swift",
    "format:fix": "oxfmt --write src test",
    "test": "node scripts/test-parallel.mjs",
    "test:voice-cli": "vitest run src/gateway/voice/voice-cli-output.test.ts src/gateway/voice/voice-cli-sessions.test.ts src/gateway/voice/voice-cli-turn.test.ts src/gateway/voice/voice-llm-turn.test.ts",
    "test:watch": "vitest",
    "test:ui": "pnpm --dir ui test",
    "test:force": "node --import tsx scripts/test-force.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "INFINIBOT_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "test:docker:live-models": "bash scripts/test-live-models-docker.sh",
    "test:docker:live-gateway": "bash scripts/test-live-gateway-models-docker.sh",
    "test:docker:cleanup": "bash scripts/test-cleanup-docker.sh",
    "test:docker:all": "pnpm test:docker:live-models && pnpm test:docker:live-gateway && pnpm test:docker:onboard && pnpm test:docker:gateway-network && pnpm test:docker:qr && pnpm test:docker:doctor-switch && pnpm test:docker:plugins && pnpm test:docker:cleanup",
    "test:all": "pnpm lint && pnpm build && pnpm test && pnpm test:e2e && pnpm test:live && pnpm test:docker:all",
    "test:install:e2e": "bash scripts/test-install-sh-e2e-docker.sh",
    "test:install:smoke": "bash scripts/test-install-sh-docker.sh",
    "test:install:e2e:openai": "INFINIBOT_E2E_MODELS=openai bash scripts/test-install-sh-e2e-docker.sh",
    "test:install:e2e:anthropic": "INFINIBOT_E2E_MODELS=anthropic bash scripts/test-install-sh-e2e-docker.sh",
    "protocol:gen": "node --import tsx scripts/protocol-gen.ts",
    "protocol:gen:swift": "node --import tsx scripts/protocol-gen-swift.ts",
    "protocol:check": "pnpm protocol:gen && pnpm protocol:gen:swift && git diff --exit-code -- dist/protocol.schema.json apps/macos/Sources/ClawdbotProtocol/GatewayModels.swift",
    "canvas:a2ui:bundle": "node scripts/bundle-a2ui.mjs",
    "knowledge:gen": "node --import tsx scripts/gen-infinibot-knowledge.ts",
    "knowledge:check": "node --import tsx scripts/gen-infinibot-knowledge.ts --check",
    "check:loc": "node --import tsx scripts/check-ts-max-loc.ts --max 500",
    "federation-sync": "node --import tsx scripts/federation-sync.ts",
    "federation-sync:daemon": "node --import tsx scripts/install-federation-sync-daemon.ts",
    "federation-sync:status": "node --import tsx scripts/federation-sync.ts status",
    "release:version": "node scripts/next-release-version.mjs",
    "install-scripts:sync": "node scripts/sync-install-scripts.mjs",
    "install-scripts:check": "node scripts/sync-install-scripts.mjs --check"
  },
